TELEGRAM_BOT_TOKEN=your_bot_token_here
DATABASE_URL=postgres://user:password@localhost:5432/blue?sslmode=disable
GROUP_ID=your_telegram_group_id
WEBHOOK_URL=https://your-domain.example/telegram/webhook-secret-path
WEBHOOK_PATH=/telegram/webhook-secret-path
WEBHOOK_SECRET=generate_32_to_256_chars_using_letters_numbers_underscore_dash
WEBHOOK_CERTIFICATE=
LISTEN_ADDR=127.0.0.1:8080
# Optional chat whose ordinary messages contribute to user/group activity counters.
LOG_CHAT_ID=
TIMEZONE=Asia/Kolkata

# Run /id inside the destination topic to get this value.
CTF_TOPIC_ID=your_ctf_topic_id
CTF_DAILY_HOUR=0
CTF_DAILY_MINUTE=0
CTF_DAILY_LOOKAHEAD_DAYS=14
CTF_TOPIC_VOTE_THRESHOLD=1
CTF_REMINDER_MINUTES_BEFORE=60

# Telegram user IDs allowed to manage CTFs, approve reactions, and use arbitrary /id lookups.
# Keep this configured in production; an empty value grants no admin access.
ADMIN_USER_IDS=
